# Copy to .env (optional — defaults work). No secrets or paid keys are needed.

PORT=4100

# Amounts within this many rupees count as equal (statutory rounding). Raise/lower to taste.
AMOUNT_TOLERANCE=1

# Names: accept an extra/missing middle or father's name as MATCHED (with a note)
ALLOW_PARTIAL_NAMES=true
# Names: accept "R KUMAR" for "RAJESH KUMAR" (initial + common surname only). Strict by default.
ALLOW_INITIAL_ONLY=false

# Identifier shapes (digits)
UAN_DIGITS=12
IP_DIGITS_MIN=10
IP_DIGITS_MAX=17

# Storage: empty = JSON files in data/runs (no database). Or a MongoDB / free Atlas URL.
MONGO_URL=

# Optional local-AI second opinion on borderline names (advisory note only; never changes a verdict).
# Needs Ollama (https://ollama.com) + `ollama pull qwen2.5:3b`.
AI_NAME_OPINION=false
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen2.5:3b

MAX_FILE_MB=50
